# 服务端配置样例。所有值均为占位符，禁止提交真实密钥。
# 真实模式（默认）：AUTH_MODE=real，必须配置三端点与平台凭据。
ENV=development
AUTH_MODE=real
AUTH_ALLOW_MOCK=0
HWSIM_BASE_URL=

SERVER_ADDR=:8443
TLS_CERT_FILE=
TLS_KEY_FILE=

# 身份模式：shared（共用一套凭据）或 per-platform（三端各自凭据）
HUAWEI_IDENTITY_MODE=shared

# shared 凭据（identityMode=shared）
HUAWEI_CLIENT_ID=<YOUR_AGC_CLIENT_ID>
HUAWEI_CLIENT_SECRET=<CHANGE_ME_16_BYTES_OR_MORE>
HUAWEI_CLIENT_SECRET_PREVIOUS=

# per-platform 凭据（identityMode=per-platform）
HUAWEI_CLIENT_ID_ANDROID=<YOUR_ANDROID_CLIENT_ID>
HUAWEI_CLIENT_SECRET_ANDROID=<CHANGE_ME>
HUAWEI_CLIENT_SECRET_PREVIOUS_ANDROID=
HUAWEI_CLIENT_ID_IOS=<YOUR_IOS_CLIENT_ID>
HUAWEI_CLIENT_SECRET_IOS=<CHANGE_ME>
HUAWEI_CLIENT_SECRET_PREVIOUS_IOS=
HUAWEI_CLIENT_ID_WINDOWS=<YOUR_WINDOWS_CLIENT_ID>
HUAWEI_CLIENT_SECRET_WINDOWS=<CHANGE_ME>
HUAWEI_CLIENT_SECRET_PREVIOUS_WINDOWS=

# 官方端点（real 模式必须精确相等，禁止镜像/代理）
HUAWEI_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_JWKS_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/certs
HUAWEI_TOKENINFO_URL=https://oauth-api.cloud.huawei.com/oauth2/v3/tokeninfo
HUAWEI_AUTHORIZE_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/authorize
HUAWEI_ISSUER_ALLOWLIST=https://accounts.huawei.com,https://oauth-login.cloud.huawei.com
AUTH_CLOCK_SKEW=60s
AUTH_JWKS_MAX_TTL=12h
AUTH_DUAL_SOURCE_CHECK=auto

HUAWEI_TIMEOUT=3s
HUAWEI_BREAKER_OPEN=15s

# AGC 身份登记（production 必填）
AUTH_APP_ID=<YOUR_AGC_APP_ID>
AUTH_ANDROID_PACKAGE_NAME=com.ict.app
AUTH_ANDROID_RELEASE_CERT_SHA256_DIGEST=<64_HEX_LOWERCASE>
AUTH_IOS_BUNDLE_ID=com.ict.app
AUTH_IOS_TEAM_ID=<10_CHARS_TEAM_ID>
AUTH_ANDROID_ALLOW_DEBUG_FINGERPRINT=0

ALLOWED_PLATFORMS=android,ios,windows
WINDOWS_REDIRECT_URIS=http://127.0.0.1:17890/callback

SESSION_TTL=24h
SESSION_RENEW_THRESHOLD=0.2
SESSION_MAX_ABSOLUTE_TTL=168h
SESSION_PEPPER=<CHANGE_ME_32_BYTE_RANDOM>

# 存储隔离：real 不得以 -mock 结尾；mock 必须以 -mock 结尾
AUTH_STORAGE_NAMESPACE=real
DATABASE_DRIVER=file
DATABASE_DSN=./data/auth.json

RATE_LIMIT_LOGIN_FAILS=10
RATE_LIMIT_CREDENTIAL_FAILS=5
TRUSTED_PROXIES=

CLIENT_MIN_VERSION_ANDROID=1.0.0
CLIENT_MIN_VERSION_IOS=1.0.0
CLIENT_MIN_VERSION_WINDOWS=1.0.0

AUDIT_SINK=file
AUDIT_QUEUE_SIZE=4096
AUTH_ALERT_SINK=log
AUTH_ALERT_WEBHOOK_URL=
AUTH_LAST_KNOWN_GOOD_PATH=
AUTH_CREDENTIAL_VERSION=
AUTH_CREDENTIAL_CHANGED_BY=
AUTH_CREDENTIAL_EFFECTIVE_AT=

AUTH_TLS_VERIFY=1
AUTH_REAL_SMOKE_ALLOW=0
LOG_LEVEL=info
METRICS_ADDR=
APP_VERSION=1.0.0