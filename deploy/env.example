# ---------------------------------------------------------------------------
# check · 华为云 Track 1 部署环境变量示例
# 复制为 deploy/.env 后填入真实值；deploy/.env 已被 .gitignore 忽略。
# ---------------------------------------------------------------------------

# 运行环境：development（离线演示）| production（真实 AGC）
ENV=development
AUTH_MODE=mock
AUTH_ALLOW_MOCK=1

# 会话与存储
SESSION_TTL=24h
SESSION_PEPPER=replace-with-32-byte-random-pepper
# mock 模式的命名空间必须以 -mock 结尾；切 real 后改为 cloud
AUTH_STORAGE_NAMESPACE=cloud-mock
DEPLOYMENT_ID=check-demo-001

# 华为云资源（VPC 内网地址；不填则 /v1/health 显示 not_configured）
CLOUD_REGION=cn-north-4
RDS_ADDR=mysql:3306
REDIS_ADDR=redis:6379

# MaaS / 模型网关健康端点（可选，必须显式配置，避免误探公网）
MAAS_HEALTH_URL=
MAAS_API_KEY=

# 本地 MySQL / Redis 容器口令（生产请改用 RDS / DCS 并轮换）
MYSQL_DATABASE=check_app
MYSQL_USER=check
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
REDIS_PASSWORD=replace-with-strong-redis-password

# 华为账号（生产必填；本地 mock 模式留空）
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
WINDOWS_REDIRECT_URI=https://your-domain.example.com/auth/windows/callback

# 微信扫码（可选）
WECHAT_ENABLED=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PRIMARY_REDIRECT_URI=
