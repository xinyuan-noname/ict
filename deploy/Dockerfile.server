# 多阶段构建：Go 服务端（authd / hwsim 共用）
# 构建上下文为仓库根目录。
FROM golang:1.23-alpine AS build

ARG TARGET=./cmd/authd
WORKDIR /src

# 先复制 go.mod 利用 Docker 层缓存；本项目零外部依赖，无需 go.sum。
COPY server/go.mod ./
RUN go mod download || true

COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/app ${TARGET}

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=build /out/app /usr/local/bin/app
RUN mkdir -p /data && chown -R app:app /app /data
USER app

ENV SERVER_ADDR=:8443 \
    ENV=production \
    DATABASE_DSN=/data/auth.json
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/app"]
