{
  "name": "ict-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "windows": "npx @react-native-community/cli run-windows",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "test:windows": "jest --config jest.config.windows.js",
    "web:dev": "webpack serve --mode development",
    "web:build": "webpack --mode production",
    "web:preview": "webpack serve --mode production",
    "web:verify": "webpack --mode production --no-stats"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@react-native-community/cli": "^15.1.3",
    "@react-native/metro-config": "^0.76.9",
    "@rnx-kit/jest-preset": "^0.1.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "react-native-windows": "^0.76.17",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.3",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "IctApp",
      "namespace": "IctApp",
      "template": "cpp-app"
    }
  }
}
